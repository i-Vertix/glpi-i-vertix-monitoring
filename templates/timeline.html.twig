{% if timeline|length %}
    <div class="table-responsive my-3">
        <table
                class="table table-vcenter">
            <thead>
            <tr>
                <th>{{ __('Date', 'ivertixmonitoring') }}</th>
                <th>{{ __('Content', 'ivertixmonitoring') }}</th>
                <th>{{ __('Status', 'ivertixmonitoring') }}</th>
                <th>{{ __('Tries', 'ivertixmonitoring') }}</th>
                <th class="w-1"></th>
            </tr>
            </thead>
            <tbody>
            {% for event in timeline %}
                <tr>
                    <td class="text-muted">{{ event.date }}</td>
                    <td class="text-muted">{{ event.content }}</td>
                    <td class="text-muted">{{ status_labels[event.status] ?? event.status }}</td>
                    <td class="text-muted">{{ event.tries }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info mt-3" role="alert">
        <h4 class="alert-title">{{ __('No event to show', 'ivertixmonitoring') }}</h4>
    </div>
{% endif %}